# Copy to ~/.config/jarvis/jarvis.env and uncomment what you want to change.
# All settings are optional; the defaults are shown.

# Language model served by Ollama (must be pulled: `ollama pull <name>`)
#JARVIS_LLM=qwen2.5:3b
#JARVIS_OLLAMA_URL=http://localhost:11434

# Whisper model for speech-to-text: tiny.en, base.en, small.en, distil-small.en, medium.en ...
#JARVIS_WHISPER=small.en

# Piper voice used for spoken replies
#JARVIS_VOICE=/usr/share/piper-voices/en/en_US/ryan/high/en_US-ryan-high.onnx

# City for weather questions (empty = wttr.in guesses from your IP address)
#JARVIS_CITY=

# Wake word sensitivity, 0-1. Raise (e.g. 0.7) if it wakes by mistake, lower if it misses you.
#JARVIS_WAKE_THRESHOLD=0.5
