#!/usr/bin/env python3
import os, sys, socket, glob, ctypes, struct
import numpy as np


def _load_config():
    """Load KEY=VALUE lines from ~/.config/jarvis/jarvis.env (real env vars win)."""
    path = os.path.expanduser(os.environ.get("JARVIS_CONFIG", "~/.config/jarvis/jarvis.env"))
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, value = line.split("=", 1)
                    os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))
    except OSError:
        pass


_load_config()

for lib in glob.glob(os.path.join(sys.prefix, "lib/python*/site-packages/nvidia/*/lib/*.so*")):
    try:
        ctypes.CDLL(lib)
    except OSError:
        pass

from faster_whisper import WhisperModel

SOCK_PATH = os.environ.get("JARVIS_SOCK", os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "jarvis.sock"))
if os.path.exists(SOCK_PATH):
    os.remove(SOCK_PATH)

WHISPER_MODEL = os.environ.get("JARVIS_WHISPER", "small.en")  # used on the GPU

# Keep Whisper warm in NVIDIA VRAM permanently (~670MB VRAM for small.en)
try:
    model = WhisperModel(WHISPER_MODEL, device="cuda", compute_type="float16")
except Exception:
    # No usable NVIDIA GPU: a smaller model keeps CPU transcription fast.
    model = WhisperModel(os.environ.get("JARVIS_WHISPER_CPU", "base.en"), device="cpu", compute_type="int8")

server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
server.bind(SOCK_PATH)
os.chmod(SOCK_PATH, 0o600)  # only this user may send audio
server.listen(5)

while True:
    conn, _ = server.accept()
    try:
        raw_len = conn.recv(4)
        if not raw_len:
            continue
        length = struct.unpack("!I", raw_len)[0]
        buf = bytearray()
        while len(buf) < length:
            packet = conn.recv(65536)
            if not packet:
                break
            buf.extend(packet)

        audio = np.frombuffer(buf, dtype=np.float32)
        segments, _ = model.transcribe(audio, beam_size=1, vad_filter=False)
        text = " ".join(s.text.strip() for s in segments).strip()
        conn.sendall(text.encode("utf-8"))
    except Exception:
        conn.sendall(b"")
    finally:
        conn.close()
